
# Local PostgreSQL defaults
POSTGRES_DB=janvaani_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_local_password

# Backend database connection
DATABASE_URL=postgresql+psycopg://postgres:replace_with_a_strong_local_password@localhost:5432/janvaani_db

# Firebase Authentication
FIREBASE_PROJECT_ID=your-firebase-project-id

# Keep development authentication disabled by default
JANVAANI_DEV_AUTH=false
JANVAANI_DEV_REVIEWER_AUTH=false
GEMINI_API_KEY=
GEMINI_MODEL=

# BHASHINI speech services (replace with your own credentials)
BHASHINI_USER_ID=replace_with_your_bhashini_user_id
BHASHINI_ULCA_API_KEY=replace_with_your_ulca_api_key
BHASHINI_TIMEOUT_SECONDS=30
